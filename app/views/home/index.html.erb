<% content_for :title, "Franhel Home Retouch" %>

<section class="overflow-hidden rounded-2xl border border-line bg-surface-2">
  <div class="px-6 py-14 text-center sm:px-12 sm:py-20">
    <p class="font-sans text-xs font-semibold uppercase tracking-[0.15em] text-brand">Painting &middot; Plumbing &middot; Electrical &middot; Tiling</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink text-balance sm:text-5xl">Renovation, without the runaround</h1>
    <p class="mx-auto mt-5 max-w-xl text-ink-muted">
      Tell us what your place needs, get a real quote from a real person, and track the job through to done &mdash; all in one place.
    </p>

    <div class="mt-9">
      <% if client_signed_in? %>
        <%= link_to "Request a service", new_service_path, class: "inline-block rounded-md bg-brand px-6 py-3 font-medium text-brand-ink hover:bg-brand-hover" %>
      <% else %>
        <%= link_to "Create an account", new_client_registration_path, class: "inline-block rounded-md bg-brand px-6 py-3 font-medium text-brand-ink hover:bg-brand-hover" %>
      <% end %>
    </div>
  </div>
</section>

<% if @portfolio_pieces.any? %>
  <section class="mt-16">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-ink text-center mb-8">Recent work</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      <% @portfolio_pieces.each do |piece| %>
        <div class="overflow-hidden rounded-xl border border-line bg-surface shadow-sm">
          <% if piece.photo.attached? %>
            <%= image_tag piece.photo, class: "h-40 w-full object-cover" %>
          <% else %>
            <div class="flex h-40 w-full items-center justify-center bg-surface-2 text-xs text-ink-muted">No photo yet</div>
          <% end %>
          <div class="p-4">
            <p class="font-medium text-ink text-sm"><%= piece.title %></p>
            <p class="mt-0.5 text-xs text-ink-muted"><%= piece.service_type %><%= " · #{piece.year}" if piece.year.present? %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @catalog_entries.any? %>
  <section class="mt-16">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-ink text-center mb-8">Our services</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <% @catalog_entries.each do |entry| %>
        <div class="rounded-xl border border-line bg-surface p-5 shadow-sm">
          <p class="font-medium text-ink"><%= entry.name %></p>
          <p class="mt-1 text-sm text-ink-muted">From KSh <%= number_with_delimiter(entry.price.to_i) %><% if entry.duration_days.present? %> &middot; ~<%= pluralize(entry.duration_days, "day") %><% end %></p>
          <% if entry.description.present? %>
            <p class="mt-3 text-sm text-ink-muted"><%= entry.description %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
