<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Franhel Home Retouch" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Franhel Home Retouch">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700&family=Work+Sans:wght@400;500;600&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if content_for?(:house_experience) %>
      <%= javascript_include_tag "house_experience", defer: true %>
    <% end %>
  </head>

  <body class="bg-ground text-ink font-sans antialiased<%= " overflow-hidden" if content_for?(:full_bleed) %>">
    <header class="relative z-10 border-b border-line bg-surface">
      <nav class="container mx-auto flex items-center justify-between gap-4 px-5 py-4">
        <%= link_to root_path, class: "font-display text-lg font-semibold tracking-tight text-ink" do %>
          Franhel <span class="text-brand">Home Retouch</span>
        <% end %>

        <div class="flex items-center gap-5 text-sm">
          <% if client_signed_in? %>
            <%= link_to "My requests", services_path, class: "text-ink-muted hover:text-ink" %>
            <% if current_client.admin? %>
              <%= link_to "Admin", admin_root_path, class: "text-ink-muted hover:text-ink" %>
            <% end %>
            <span class="hidden text-line sm:inline">|</span>
            <span class="hidden text-ink-muted sm:inline"><%= current_client.display_name %></span>
            <%= button_to "Log out", destroy_client_session_path, method: :delete, class: "text-ink-muted underline hover:text-ink" %>
          <% else %>
            <%= link_to "Log in", new_client_session_path, class: "text-ink-muted hover:text-ink" %>
            <%= link_to "Sign up", new_client_registration_path, class: "rounded-md bg-brand px-3.5 py-1.5 font-medium text-brand-ink hover:bg-brand-hover" %>
          <% end %>
        </div>
      </nav>
    </header>

    <% if notice %>
      <p class="relative z-10 bg-good-soft px-5 py-3 text-center text-sm text-good"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="relative z-10 bg-danger-soft px-5 py-3 text-center text-sm text-danger"><%= alert %></p>
    <% end %>

    <% if content_for?(:full_bleed) %>
      <main class="h-[calc(100svh-65px)] w-full">
        <%= yield %>
      </main>
    <% else %>
      <main class="container mx-auto max-w-4xl px-5 py-12">
        <%= yield %>
      </main>

      <footer class="mt-20 border-t border-line py-8">
        <p class="container mx-auto px-5 text-sm text-ink-muted">Franhel Home Retouch &mdash; renovation, without the runaround.</p>
      </footer>
    <% end %>
  </body>
</html>
