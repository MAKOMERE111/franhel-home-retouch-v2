<% content_for :title, "Admin" %>

<h1 class="font-display text-2xl font-semibold tracking-tight text-ink mb-8">Admin</h1>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
  <%= link_to services_path, class: "block rounded-xl border border-line bg-surface p-5 shadow-sm hover:border-brand" do %>
    <p class="font-display text-3xl font-semibold tabular-nums text-ink"><%= @open_requests_count %></p>
    <p class="mt-1 text-sm text-ink-muted">Open requests</p>
  <% end %>

  <%= link_to admin_portfolio_pieces_path, class: "block rounded-xl border border-line bg-surface p-5 shadow-sm hover:border-brand" do %>
    <p class="font-display text-3xl font-semibold tabular-nums text-ink"><%= @portfolio_count %></p>
    <p class="mt-1 text-sm text-ink-muted">Portfolio pieces</p>
  <% end %>

  <%= link_to admin_service_catalog_entries_path, class: "block rounded-xl border border-line bg-surface p-5 shadow-sm hover:border-brand" do %>
    <p class="font-display text-3xl font-semibold tabular-nums text-ink"><%= @catalog_count %></p>
    <p class="mt-1 text-sm text-ink-muted">Catalog entries</p>
  <% end %>
</div>

<ul class="space-y-2 text-sm">
  <li><%= link_to "All service requests →", services_path, class: "text-brand hover:text-brand-hover" %></li>
  <li><%= link_to "Manage portfolio →", admin_portfolio_pieces_path, class: "text-brand hover:text-brand-hover" %></li>
  <li><%= link_to "Manage service catalog →", admin_service_catalog_entries_path, class: "text-brand hover:text-brand-hover" %></li>
</ul>
