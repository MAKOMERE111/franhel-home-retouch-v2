<%= form_with model: [:admin, entry], class: "space-y-5 max-w-sm" do |f| %>
  <% if entry.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-stone-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-stone-700" %>
    <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
  </div>

  <div>
    <%= f.label :price_shillings, "Estimated price (KSh)", class: "block text-sm font-medium text-stone-700" %>
    <%= f.text_field :price_shillings, class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
  </div>

  <div>
    <%= f.label :duration_days, "Typical duration (days)", class: "block text-sm font-medium text-stone-700" %>
    <%= f.number_field :duration_days, class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-orange-600 px-4 py-2 text-sm text-white hover:bg-orange-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_service_catalog_entries_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
  </div>
<% end %>
