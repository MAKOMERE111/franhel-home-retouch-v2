<%= form_with model: [:admin, entry], class: "space-y-5 max-w-sm" do |f| %>
  <% if entry.errors.any? %>
    <div class="rounded-md bg-danger-soft px-4 py-3 text-sm text-danger">
      <ul class="list-disc list-inside">
        <% entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-ink" %>
    <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :price_shillings, "Estimated price (KSh)", class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :price_shillings, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :duration_days, "Typical duration (days)", class: "block text-sm font-medium text-ink" %>
    <%= f.number_field :duration_days, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
    <%= link_to "Cancel", admin_service_catalog_entries_path, class: "text-sm text-ink-muted hover:text-ink" %>
  </div>
<% end %>
