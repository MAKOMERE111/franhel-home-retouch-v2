<% content_for :title, "Service catalog" %>

<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-semibold tracking-tight">Service catalog</h1>
  <%= link_to "Add entry", new_admin_service_catalog_entry_path, class: "rounded-md bg-orange-600 px-4 py-2 text-sm text-white hover:bg-orange-700" %>
</div>

<% if @entries.empty? %>
  <p class="text-stone-500">No catalog entries yet.</p>
<% else %>
  <ul class="space-y-3">
    <% @entries.each do |entry| %>
      <li class="rounded-lg border border-stone-200 bg-white p-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-medium text-stone-900"><%= entry.name %></p>
            <p class="text-sm text-stone-500">KSh <%= number_with_delimiter(entry.price.to_i) %><% if entry.duration_days.present? %> · ~<%= pluralize(entry.duration_days, "day") %><% end %></p>
            <% if entry.description.present? %>
              <p class="mt-1 text-sm text-stone-600"><%= entry.description %></p>
            <% end %>
          </div>
          <div class="flex gap-3 text-sm flex-none">
            <%= link_to "Edit", edit_admin_service_catalog_entry_path(entry), class: "text-stone-600 hover:text-stone-900" %>
            <%= button_to "Remove", admin_service_catalog_entry_path(entry), method: :delete, class: "text-red-600 hover:text-red-800", form: { data: { turbo_confirm: "Remove this entry?" } } %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<p class="mt-8">
  <%= link_to "← Back to admin", admin_root_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
</p>
