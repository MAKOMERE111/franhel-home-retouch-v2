<% content_for :title, "Service catalog" %>

<div class="flex items-center justify-between mb-8">
  <h1 class="font-display text-2xl font-semibold tracking-tight text-ink">Service catalog</h1>
  <%= link_to "Add entry", new_admin_service_catalog_entry_path, class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover" %>
</div>

<% if @entries.empty? %>
  <div class="rounded-xl border border-dashed border-line py-14 text-center">
    <p class="text-ink-muted">No catalog entries yet.</p>
  </div>
<% else %>
  <ul class="space-y-3">
    <% @entries.each do |entry| %>
      <li class="rounded-xl border border-line bg-surface p-4 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-medium text-ink"><%= entry.name %></p>
            <p class="text-sm text-ink-muted">KSh <%= number_with_delimiter(entry.price.to_i) %><% if entry.duration_days.present? %> · ~<%= pluralize(entry.duration_days, "day") %><% end %></p>
            <% if entry.description.present? %>
              <p class="mt-1 text-sm text-ink-muted"><%= entry.description %></p>
            <% end %>
          </div>
          <div class="flex gap-3 text-sm flex-none">
            <%= link_to "Edit", edit_admin_service_catalog_entry_path(entry), class: "text-ink-muted hover:text-ink" %>
            <%= button_to "Remove", admin_service_catalog_entry_path(entry), method: :delete, class: "text-danger hover:opacity-80", form: { data: { turbo_confirm: "Remove this entry?" } } %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<p class="mt-8">
  <%= link_to "← Back to admin", admin_root_path, class: "text-sm text-ink-muted hover:text-ink" %>
</p>
