<% content_for :title, "Portfolio" %>

<div class="flex items-center justify-between mb-8">
  <h1 class="font-display text-2xl font-semibold tracking-tight text-ink">Portfolio</h1>
  <%= link_to "Add piece", new_admin_portfolio_piece_path, class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover" %>
</div>

<% if @portfolio_pieces.empty? %>
  <div class="rounded-xl border border-dashed border-line py-14 text-center">
    <p class="text-ink-muted">Nothing in the portfolio yet.</p>
  </div>
<% else %>
  <ul class="space-y-3">
    <% @portfolio_pieces.each do |piece| %>
      <li class="flex items-center gap-4 rounded-xl border border-line bg-surface p-4 shadow-sm">
        <% if piece.photo.attached? %>
          <%= image_tag piece.photo, class: "h-16 w-16 rounded-md object-cover flex-none" %>
        <% else %>
          <div class="h-16 w-16 rounded-md bg-surface-2 flex-none"></div>
        <% end %>
        <div class="flex-1 min-w-0">
          <p class="font-medium text-ink"><%= piece.title %></p>
          <p class="text-sm text-ink-muted"><%= piece.service_type %> · <%= piece.address %><%= " · #{piece.year}" if piece.year.present? %></p>
        </div>
        <div class="flex gap-3 text-sm flex-none">
          <%= link_to "Edit", edit_admin_portfolio_piece_path(piece), class: "text-ink-muted hover:text-ink" %>
          <%= button_to "Remove", admin_portfolio_piece_path(piece), method: :delete, class: "text-danger hover:opacity-80", form: { data: { turbo_confirm: "Remove this piece?" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<p class="mt-8">
  <%= link_to "← Back to admin", admin_root_path, class: "text-sm text-ink-muted hover:text-ink" %>
</p>
