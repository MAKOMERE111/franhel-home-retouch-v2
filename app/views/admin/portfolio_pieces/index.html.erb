<% content_for :title, "Portfolio" %>

<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-semibold tracking-tight">Portfolio</h1>
  <%= link_to "Add piece", new_admin_portfolio_piece_path, class: "rounded-md bg-orange-600 px-4 py-2 text-sm text-white hover:bg-orange-700" %>
</div>

<% if @portfolio_pieces.empty? %>
  <p class="text-stone-500">Nothing in the portfolio yet.</p>
<% else %>
  <ul class="space-y-3">
    <% @portfolio_pieces.each do |piece| %>
      <li class="flex items-center gap-4 rounded-lg border border-stone-200 bg-white p-4">
        <% if piece.photo.attached? %>
          <%= image_tag piece.photo, class: "h-16 w-16 rounded-md object-cover flex-none" %>
        <% else %>
          <div class="h-16 w-16 rounded-md bg-stone-100 flex-none"></div>
        <% end %>
        <div class="flex-1 min-w-0">
          <p class="font-medium text-stone-900"><%= piece.title %></p>
          <p class="text-sm text-stone-500"><%= piece.service_type %> · <%= piece.address %><%= " · #{piece.year}" if piece.year.present? %></p>
        </div>
        <div class="flex gap-3 text-sm flex-none">
          <%= link_to "Edit", edit_admin_portfolio_piece_path(piece), class: "text-stone-600 hover:text-stone-900" %>
          <%= button_to "Remove", admin_portfolio_piece_path(piece), method: :delete, class: "text-red-600 hover:text-red-800", form: { data: { turbo_confirm: "Remove this piece?" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<p class="mt-8">
  <%= link_to "← Back to admin", admin_root_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
</p>
