<%= form_with model: [:admin, portfolio_piece], class: "space-y-5 max-w-sm" do |f| %>
  <% if portfolio_piece.errors.any? %>
    <div class="rounded-md bg-danger-soft px-4 py-3 text-sm text-danger">
      <ul class="list-disc list-inside">
        <% portfolio_piece.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :service_type, "Service type", class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :service_type, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :address, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :year, class: "block text-sm font-medium text-ink" %>
    <%= f.number_field :year, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :photo, "Photo", class: "block text-sm font-medium text-ink" %>
    <% if portfolio_piece.photo.attached? %>
      <%= image_tag portfolio_piece.photo, class: "mt-2 h-24 w-24 rounded-md object-cover" %>
    <% end %>
    <%= f.file_field :photo, accept: "image/*", class: "mt-1 block w-full text-sm text-ink-muted" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
    <%= link_to "Cancel", admin_portfolio_pieces_path, class: "text-sm text-ink-muted hover:text-ink" %>
  </div>
<% end %>
