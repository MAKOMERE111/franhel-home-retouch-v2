<% content_for :title, "Log in" %>

<h1 class="font-display text-2xl font-semibold tracking-tight text-ink mb-8">Log in</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5 max-w-sm" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-ink" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-ink" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "rounded border-line text-brand focus:ring-brand" %>
      <%= f.label :remember_me, class: "text-sm text-ink" %>
    </div>
  <% end %>

  <%= f.submit "Log in", class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
<% end %>

<div class="mt-6 text-sm text-ink-muted space-y-1">
  <%= render "devise/shared/links" %>
</div>
