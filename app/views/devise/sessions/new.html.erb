<% content_for :title, "Log in" %>

<h1 class="text-2xl font-semibold tracking-tight mb-8">Log in</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5 max-w-sm" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-stone-700" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-stone-700" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "rounded border-stone-300 text-orange-600 focus:ring-orange-500" %>
      <%= f.label :remember_me, class: "text-sm text-stone-700" %>
    </div>
  <% end %>

  <%= f.submit "Log in", class: "rounded-md bg-orange-600 px-4 py-2 text-sm text-white hover:bg-orange-700 cursor-pointer" %>
<% end %>

<div class="mt-6 text-sm text-stone-600 space-y-1">
  <%= render "devise/shared/links" %>
</div>
