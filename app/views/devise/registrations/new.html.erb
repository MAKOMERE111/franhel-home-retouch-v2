<% content_for :title, "Sign up" %>

<h1 class="font-display text-2xl font-semibold tracking-tight text-ink mb-8">Create an account</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5 max-w-sm" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :name, autofocus: true, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-ink" %>
    <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-ink" %>
    <% if @minimum_password_length %>
      <p class="text-xs text-ink-muted"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-ink" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <%= f.submit "Sign up", class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
<% end %>

<div class="mt-6 text-sm text-ink-muted space-y-1">
  <%= render "devise/shared/links" %>
</div>
