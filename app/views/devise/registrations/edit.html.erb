<% content_for :title, "Edit account" %>

<h1 class="font-display text-2xl font-semibold tracking-tight text-ink mb-8">Edit account</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5 max-w-sm" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :name, autofocus: true, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-ink" %>
    <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-ink" %>
    <p class="text-xs text-ink-muted">Leave blank if you don't want to change it<% if @minimum_password_length %> (<%= @minimum_password_length %> characters minimum)<% end %></p>
    <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-ink" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :current_password, class: "block text-sm font-medium text-ink" %>
    <p class="text-xs text-ink-muted">We need your current password to confirm these changes</p>
    <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <%= f.submit "Update", class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
<% end %>

<div class="mt-10 border-t border-line pt-6">
  <p class="text-sm text-ink-muted mb-2">Unhappy?</p>
  <%= button_to "Cancel my account", registration_path(resource_name), data: { turbo_confirm: "Are you sure?" }, method: :delete, class: "text-sm text-danger hover:opacity-80" %>
</div>
