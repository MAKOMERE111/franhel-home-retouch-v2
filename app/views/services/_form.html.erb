<%= form_with model: service, class: "space-y-5" do |f| %>
  <% if service.errors.any? %>
    <div class="rounded-md bg-danger-soft px-4 py-3 text-sm text-danger">
      <p class="font-medium">Please fix the following:</p>
      <ul class="mt-1 list-disc list-inside">
        <% service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :service, "Type of service", class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :service, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :location, "Property / apartment", class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :location, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :address, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :contact_info, "Phone number", class: "block text-sm font-medium text-ink" %>
    <%= f.text_field :contact_info, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-ink" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
  </div>

  <% if current_client.admin? && service.persisted? %>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-ink" %>
      <%= f.select :status, Service.aasm.states.map(&:name).map(&:to_s), {}, class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
    </div>
  <% end %>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
    <%= link_to "Cancel", services_path, class: "text-sm text-ink-muted hover:text-ink" %>
  </div>
<% end %>
