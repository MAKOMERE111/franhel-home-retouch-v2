<% content_for :title, "My requests" %>

<div class="flex items-center justify-between mb-8">
  <h1 class="font-display text-2xl font-semibold tracking-tight text-ink"><%= current_client.admin? ? "All requests" : "My requests" %></h1>
  <%= link_to "New request", new_service_path, class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover" %>
</div>

<% if @services.empty? %>
  <div class="rounded-xl border border-dashed border-line py-14 text-center">
    <p class="text-ink-muted">No requests yet.</p>
  </div>
<% else %>
  <ul id="services" class="space-y-3">
    <% @services.each do |service| %>
      <%= render "service", service: service %>
    <% end %>
  </ul>
<% end %>
