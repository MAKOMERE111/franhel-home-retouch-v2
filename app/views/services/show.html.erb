<% content_for :title, @service.service %>

<div class="flex items-start justify-between mb-8">
  <div>
    <h1 class="font-display text-2xl font-semibold tracking-tight text-ink"><%= @service.service %></h1>
    <span class="<%= status_badge_classes(@service.status) %> mt-2"><%= @service.status.humanize %></span>
  </div>
  <div class="flex gap-3 text-sm">
    <%= link_to "Edit", edit_service_path(@service), class: "text-ink-muted hover:text-ink" %>
    <% if @service.may_cancel? %>
      <%= button_to "Cancel request", cancel_service_path(@service), method: :patch, class: "text-danger hover:opacity-80", form: { data: { turbo_confirm: "Cancel this request?" } } %>
    <% end %>
  </div>
</div>

<dl class="space-y-4 text-sm">
  <div>
    <dt class="text-ink-muted">Property</dt>
    <dd class="text-ink"><%= @service.location %></dd>
  </div>
  <div>
    <dt class="text-ink-muted">Address</dt>
    <dd class="text-ink"><%= @service.address %></dd>
  </div>
  <div>
    <dt class="text-ink-muted">Contact</dt>
    <dd class="text-ink"><%= @service.contact_info %></dd>
  </div>
  <div>
    <dt class="text-ink-muted">Description</dt>
    <dd class="text-ink whitespace-pre-line"><%= @service.description %></dd>
  </div>
  <% if current_client.admin? %>
    <div>
      <dt class="text-ink-muted">Requested by</dt>
      <dd class="text-ink"><%= @service.client.display_name %> (<%= @service.client.email %>)</dd>
    </div>
  <% end %>
</dl>

<div class="mt-10 border-t border-line pt-6">
  <% if @service.quote.present? %>
    <h2 class="font-display text-sm font-semibold text-ink-muted">Quote</h2>
    <p class="mt-2 font-display text-2xl font-semibold text-ink">KSh <%= number_with_delimiter(@service.quote.price.to_i) %></p>
    <% if @service.quote.notes.present? %>
      <p class="mt-1 text-sm text-ink-muted"><%= @service.quote.notes %></p>
    <% end %>
  <% elsif current_client.admin? && @service.requested? %>
    <h2 class="font-display text-sm font-semibold text-ink-muted mb-3">Send a quote</h2>
    <%= form_with url: service_quotes_path(@service), class: "space-y-4 max-w-sm" do |f| %>
      <div>
        <%= f.label :price_dollars, "Price (KSh)", class: "block text-sm font-medium text-ink" %>
        <%= f.text_field "quote[price_dollars]", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
      </div>
      <div>
        <%= f.label :notes, "Notes (optional)", for: "quote_notes", class: "block text-sm font-medium text-ink" %>
        <%= f.text_area "quote[notes]", rows: 3, id: "quote_notes", class: "mt-1 block w-full rounded-md border-line bg-surface shadow-sm focus:border-brand focus:ring-brand" %>
      </div>
      <%= f.submit "Send quote", class: "rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-hover cursor-pointer" %>
    <% end %>
  <% end %>
</div>

<p class="mt-8">
  <%= link_to "← Back to requests", services_path, class: "text-sm text-ink-muted hover:text-ink" %>
</p>
