<% content_for :title, @service.service %>

<div class="flex items-start justify-between mb-8">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight"><%= @service.service %></h1>
    <span class="<%= status_badge_classes(@service.status) %> mt-2"><%= @service.status.humanize %></span>
  </div>
  <div class="flex gap-3 text-sm">
    <%= link_to "Edit", edit_service_path(@service), class: "text-stone-600 hover:text-stone-900" %>
    <% if @service.may_cancel? %>
      <%= button_to "Cancel request", cancel_service_path(@service), method: :patch, class: "text-red-600 hover:text-red-800", form: { data: { turbo_confirm: "Cancel this request?" } } %>
    <% end %>
  </div>
</div>

<dl class="space-y-4 text-sm">
  <div>
    <dt class="text-stone-500">Property</dt>
    <dd class="text-stone-900"><%= @service.location %></dd>
  </div>
  <div>
    <dt class="text-stone-500">Address</dt>
    <dd class="text-stone-900"><%= @service.address %></dd>
  </div>
  <div>
    <dt class="text-stone-500">Contact</dt>
    <dd class="text-stone-900"><%= @service.contact_info %></dd>
  </div>
  <div>
    <dt class="text-stone-500">Description</dt>
    <dd class="text-stone-900 whitespace-pre-line"><%= @service.description %></dd>
  </div>
  <% if current_client.admin? %>
    <div>
      <dt class="text-stone-500">Requested by</dt>
      <dd class="text-stone-900"><%= @service.client.display_name %> (<%= @service.client.email %>)</dd>
    </div>
  <% end %>
</dl>

<div class="mt-10 border-t border-stone-200 pt-6">
  <% if @service.quote.present? %>
    <h2 class="text-sm font-medium text-stone-700">Quote</h2>
    <p class="mt-2 text-2xl font-semibold text-stone-900">KSh <%= number_with_delimiter(@service.quote.price.to_i) %></p>
    <% if @service.quote.notes.present? %>
      <p class="mt-1 text-sm text-stone-600"><%= @service.quote.notes %></p>
    <% end %>
  <% elsif current_client.admin? && @service.requested? %>
    <h2 class="text-sm font-medium text-stone-700 mb-3">Send a quote</h2>
    <%= form_with url: service_quotes_path(@service), class: "space-y-4 max-w-sm" do |f| %>
      <div>
        <%= f.label :price_dollars, "Price (KSh)", class: "block text-sm font-medium text-stone-700" %>
        <%= f.text_field "quote[price_dollars]", class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
      </div>
      <div>
        <%= f.label :notes, "Notes (optional)", for: "quote_notes", class: "block text-sm font-medium text-stone-700" %>
        <%= f.text_area "quote[notes]", rows: 3, id: "quote_notes", class: "mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
      </div>
      <%= f.submit "Send quote", class: "rounded-md bg-orange-600 px-4 py-2 text-sm text-white hover:bg-orange-700 cursor-pointer" %>
    <% end %>
  <% end %>
</div>

<p class="mt-8">
  <%= link_to "← Back to requests", services_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
</p>
