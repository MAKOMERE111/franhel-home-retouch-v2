<li id="<%= dom_id(service) %>" class="rounded-lg border border-stone-200 bg-white p-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to service.service, service, class: "font-medium text-stone-900 hover:underline" %>
      <p class="mt-1 text-sm text-stone-500"><%= service.location %> · <%= service.address %></p>
      <% if current_client.admin? %>
        <p class="mt-1 text-xs text-stone-400">Requested by <%= service.client.email %></p>
      <% end %>
    </div>
    <span class="<%= status_badge_classes(service.status) %>"><%= service.status.humanize %></span>
  </div>
</li>
