<li id="<%= dom_id(service) %>" class="rounded-xl border border-line bg-surface p-4 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to service.service, service, class: "font-medium text-ink hover:text-brand" %>
      <p class="mt-1 text-sm text-ink-muted"><%= service.location %> · <%= service.address %></p>
      <% if current_client.admin? %>
        <p class="mt-1 text-xs text-ink-muted">Requested by <%= service.client.display_name %></p>
      <% end %>
    </div>
    <span class="<%= status_badge_classes(service.status) %>"><%= service.status.humanize %></span>
  </div>
</li>
